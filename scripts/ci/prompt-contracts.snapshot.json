            "maximum": 300000,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "jobId"
        ],
        "type": "object"
      }
    },
    {
      "description": "Run a shell command. Foreground mode is for finite commands: timeoutMs controls how long Panda waits and timeout terminates the process group. Use background=true with maxRuntimeMs for servers, watchers, tailers, and other non-terminating processes; it returns a jobId immediately and never mutates the shared shell session. Verify readiness with a separate bounded health command, then cancel the job when finished. Every panda invocation is independent, so prefer one mutating Panda command per bash call. Use background_job_status, background_job_wait, and background_job_cancel for follow-up.",
      "name": "bash",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "background": {
            "description": "Set true only for servers, watchers, tailers, and other non-terminating commands.",
            "type": "boolean"
          },
          "command": {
            "minLength": 1,
            "type": "string"
          },
          "cwd": {
            "minLength": 1,
            "type": "string"
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "maxRuntimeMs": {
            "description": "Maximum lifetime of a background process before Panda terminates its process group.",
            "maximum": 21600000,
            "minimum": 100,
            "type": "integer"
          },
          "target": {
            "description": "Optional registered bash target alias.",
            "minLength": 1,
            "type": "string"
          },
          "timeoutMs": {
            "description": "Maximum time to wait for a finite foreground command. Timeout terminates the process group.",
            "maximum": 300000,
            "minimum": 100,
            "type": "integer"
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      }
    },
    {
      "description": "Drive a stateful Chromium browser session: navigate, inspect the page, click, type, wait, evaluate, screenshot, print PDF, and close the session. Use deviceProfile for desktop, desktop-wide, mobile, mobile-compact, or tablet responsive QA.",
      "name": "browser",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "navigate",
              "snapshot",
              "click",
              "type",
              "press",
              "select",
              "wait",
              "evaluate",
              "screenshot",
              "pdf",
              "close"
            ],
            "type": "string"
          },
          "arg": {},
          "deviceProfile": {
            "description": "Optional browser device profile. Use desktop by default; use mobile, mobile-compact, tablet, or desktop-wide for responsive QA.",
            "enum": [
              "desktop",
              "desktop-wide",
              "mobile-compact",
              "mobile",
              "tablet"
            ],
            "type": "string"
          },
          "fullPage": {
            "type": "boolean"
          },
          "key": {
            "minLength": 1,
            "type": "string"
          },
          "labels": {
            "type": "boolean"
          },
          "loadState": {
            "enum": [
              "load",
              "domcontentloaded",
              "networkidle"
            ],
            "type": "string"
          },
          "ref": {
            "minLength": 1,
            "type": "string"
          },
          "script": {
            "minLength": 1,
            "type": "string"
          },
          "selector": {
            "minLength": 1,
            "type": "string"
          },
          "snapshotMode": {
            "enum": [
              "compact",
              "full"
            ],
            "type": "string"
          },
          "submit": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          },
          "timeoutMs": {
            "maximum": 300000,
            "minimum": 1,
            "type": "integer"
          },
          "url": {
            "format": "uri",
            "type": "string"
          },
          "value": {
