# Core runtime
DATABASE_URL=postgresql:///panda_dev
# panda-core DB pool caps. Keep query, LISTEN, trace-writer, and readonly traffic separate.
PANDA_CORE_DB_POOL_MAX=4
PANDA_CORE_NOTIFICATION_DB_POOL_MAX=4
PANDA_CORE_READONLY_DB_POOL_MAX=1
# Process-local execution backpressure. Durable run ownership remains in Postgres.
PANDA_CORE_THREAD_RUN_CONCURRENCY=8
# Grace period for cooperative thread cancellation before lease-fenced shutdown continues.
PANDA_CORE_THREAD_RUN_DRAIN_TIMEOUT_MS=30000
# Grace period for cooperative external background jobs before lease release.
PANDA_CORE_BACKGROUND_JOB_DRAIN_TIMEOUT_MS=5000
PANDA_SCHEDULED_TASK_CONCURRENCY=4
# Agent-controlled heartbeat interval bounds in whole minutes.
PANDA_HEARTBEAT_MIN_EVERY_MINUTES=15
PANDA_HEARTBEAT_MAX_EVERY_MINUTES=1440
# Mechanical scheduler. Prefer the core-only mounted file in Docker deployments.
# Generate it with: install -m 600 /dev/null ~/.panda-core-secrets/scheduled-command-integrity.key
# Then write the output of `openssl rand -hex 32` into that file.
PANDA_SCHEDULED_COMMAND_INTEGRITY_KEY=
# Set only one integrity-key variable. The file setting is a container path, for
# example /run/secrets/panda-core/scheduled-command-integrity.key.
PANDA_SCHEDULED_COMMAND_INTEGRITY_KEY_FILE=
# Host directory mounted read-only into panda-core only.
PANDA_CORE_SECRETS_HOST_ROOT=${HOME}/.panda-core-secrets
PANDA_SCHEDULED_COMMAND_CONCURRENCY=2
# Best-effort model-call telemetry uses a separate single-client pool.
PANDA_CORE_MODEL_CALL_DB_POOL_MAX=1
# Native pg connection checkout timeout. Bounds pool waiting queues instead of silently piling up promises.
PANDA_DB_POOL_ACQUIRE_TIMEOUT_MS=10000
# panda-core health fails after sustained query-pool waiters.
PANDA_CORE_HEALTH_POOL_WAITING_STALE_MS=60000
# Renewable ownership lease for runtime requests left by a crashed core.
PANDA_RUNTIME_REQUEST_CLAIM_LEASE_MS=300000
# Independent causal streams may execute together; each stream remains FIFO in Postgres.
PANDA_RUNTIME_REQUEST_CONCURRENCY=4
# Grace period for cooperative request handlers before claim renewal stops and shutdown continues.
PANDA_RUNTIME_REQUEST_DRAIN_TIMEOUT_MS=30000
# Per-service shutdown join bound; prevents a stuck heartbeat/socket from blocking daemon exit.
PANDA_DAEMON_SERVICE_STOP_TIMEOUT_MS=5000
# Model-call metadata is cheap and useful for trends; forensic snapshots are
# short-lived, byte-capped, and captured for failures by default.
PANDA_MODEL_CALL_ATTEMPT_RETENTION_DAYS=90
PANDA_MODEL_CALL_SNAPSHOT_RETENTION_DAYS=7
PANDA_MODEL_CALL_SNAPSHOT_MAX_BYTES=1048576
PANDA_MODEL_CALL_SUCCESS_SNAPSHOT_SAMPLE_RATE=0
# Required for stored credentials and encrypted wiki bindings.
CREDENTIALS_MASTER_KEY=
# Optional read-only connection for the SQL inspection tool.
READONLY_DATABASE_URL=
# Docker stack helper. Comma-separated agent keys for per-agent bash runners.
PANDA_AGENTS=
# Optional host path overrides for the docker stack helper.
SHARED_ROOT=
# Comma-separated declared agents allowed to mount SHARED_ROOT. Unset defaults to PANDA_AGENTS;
# an explicitly empty value removes the mount from every persistent runner.
# PANDA_SHARED_WORKSPACE_AGENTS=panda,jozef
BROWSER_RUNNER_ROOT=
# Optional host path to a Codex home directory with auth.json.
# Useful when Docker should use a non-default host login like /home/username/.codex.
CODEX_HOST_HOME=
# Optional runtime timezone for Panda Docker services.
TZ=UTC
# Optional app host base URLs.
PANDA_APPS_HOST=
PANDA_APPS_PORT=
PANDA_APPS_BASE_URL=
PANDA_APPS_PUBLIC_HOST=
PANDA_APPS_INTERNAL_BASE_URL=
# Tailscale-only mode publishes apps/gateway on host loopback for `tailscale serve`
# instead of generating the public Caddy edge. Use /apps and /gateway path prefixes.
PANDA_TAILNET_SERVE_ENABLED=
PANDA_APPS_PUBLISH_HOST=
PANDA_APPS_PUBLISH_PORT=
# Optional host IP for the public Caddy edge. Use a concrete public interface IP
# when another service owns :80/:443 on another interface, for example Tailscale.
PANDA_PUBLIC_BIND_IP=
# Optional public gateway edge for the docker stack. Requires HTTPS via Caddy.
PANDA_GATEWAY_ENABLED=
PANDA_GATEWAY_BASE_URL=
PANDA_GATEWAY_PUBLIC_HOST=
PANDA_GATEWAY_EDGE_SUBNET=172.31.94.0/24
GATEWAY_PUBLISH_HOST=
GATEWAY_PUBLISH_PORT=

# Gateway ingress
# Public server-to-server REST ingress. Leave host at 127.0.0.1 for local-only runs.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8094
GATEWAY_PATH_PREFIX=
# Required when binding gateway to a public host like 0.0.0.0. Comma-separated IPs or CIDRs.
GATEWAY_IP_ALLOWLIST=
# Set only to trusted reverse proxy IPs/CIDRs. The proxy must strip incoming X-Forwarded-For.
GATEWAY_TRUSTED_PROXY_IPS=
# Explicit unsafe escape hatch for public binds without an IP allowlist. Do not use in production.
GATEWAY_ALLOW_PUBLIC_WITHOUT_IP_ALLOWLIST=
# Required by `panda gateway run`.
GATEWAY_GUARD_MODEL=
# Optional tuning.
GATEWAY_GUARD_TIMEOUT_MS=
GATEWAY_ACCESS_TOKEN_TTL_MS=
GATEWAY_MAX_ACTIVE_TOKENS_PER_SOURCE=
GATEWAY_MAX_TEXT_BYTES=
GATEWAY_RATE_LIMIT_PER_MINUTE=
GATEWAY_TEXT_BYTES_PER_HOUR=

# Bash execution
# Default is `local`. Set to `remote` in panda-core when bash should run through per-agent runners.
BASH_EXECUTION_MODE=local
# panda-core only. Use `{agentKey}` for per-agent routing, or a plain URL for a single shared runner.
BASH_SERVER_URL_TEMPLATE=
# panda-core only. Optional initial cwd for remote-mode threads before the first bash call.
# Use `{agentKey}` for per-agent homes, for example `/root/.panda/agents/{agentKey}`.
BASH_SERVER_CWD_TEMPLATE=
# core only. Explicit retention declaration for fallback remote runners, independent of cwd/HOME.
# JSON array of absolute runner paths; {agentKey} is expanded per agent. Unset means unspecified.
# The generated Docker stack sets ["/root/.panda/agents/{agentKey}"]. This creates no mounts.
BASH_SERVER_PERSISTENT_ROOTS_TEMPLATE=
# runner only. The runner serves exactly one agent.
BASH_SERVER_AGENT_KEY=
# core only. HMAC master used to derive a unique token per agent/environment.
# Prefer the file form. docker-stack.sh creates and mounts its own owner-only key file.
PANDA_RUNNER_TOKEN_MASTER_KEY=
PANDA_RUNNER_TOKEN_MASTER_KEY_FILE=
# runner only. Exactly one derived token; prefer the owner-only file form.
BASH_SERVER_AUTH_TOKEN=
BASH_SERVER_AUTH_TOKEN_FILE=
# Migration-only global bearer. New deployments must use scoped runner tokens.
BASH_SERVER_SHARED_SECRET=
# runner only. Optional allowed initial cwd roots separated by your OS path delimiter (`:` on macOS/Linux).
# This is a cwd guard, not a sandbox; container mounts still define the filesystem boundary.
BASH_SERVER_ALLOWED_ROOTS=
# runner only.
BASH_SERVER_PORT=8080
BASH_SERVER_HOST=0.0.0.0

# Panda command server
# docker-stack.sh enables this privately for Docker runners through the base compose file.
# It should stay unlisted here for normal single-host Docker deploys; override only for custom topology.
# Command access tokens are issued dynamically by Panda; do not configure static server tokens.
# Same-host stacks default to the Unix socket. Use HTTP only for explicitly remote runners.
PANDA_COMMAND_TRANSPORT=socket
PANDA_COMMAND_SOCKET_HOST_DIR=
PANDA_COMMAND_SOCKET_MOUNTED_RUNNERS=
# PANDA_COMMAND_SERVER_ENABLED=true
# PANDA_COMMAND_SERVER_URL=http://panda-core:8096

# Disposable execution environments
# docker-stack.sh only. Set true to run the managed disposable environment service.
PANDA_DISPOSABLE_ENVIRONMENTS_ENABLED=
# panda-core only. HTTP endpoint for the separate environment manager process.
PANDA_EXECUTION_ENVIRONMENT_MANAGER_URL=
# Shared bearer token used between panda-core and the environment manager.
PANDA_EXECUTION_ENVIRONMENT_MANAGER_TOKEN=
# environment-manager only. Bind publicly only with PANDA_EXECUTION_ENVIRONMENT_MANAGER_TOKEN set.
PANDA_EXECUTION_ENVIRONMENT_MANAGER_HOST=127.0.0.1
PANDA_EXECUTION_ENVIRONMENT_MANAGER_PORT=8095
# environment-manager only. Docker Engine endpoint.
PANDA_DOCKER_HOST=unix:///var/run/docker.sock
# docker-stack.sh build only. Node major used when building panda-runner:latest.
# Defaults to Node 22 LTS for disposable/browser validation stability.
PANDA_RUNNER_NODE_MAJOR=22
# environment-manager only. Runner image and network/cwd for disposable containers.
PANDA_DISPOSABLE_RUNNER_IMAGE=panda-runner:latest
# Optional explicit workspace substrate image. When unset, docker-stack.sh computes
# a content-addressed panda-workspace:<hash> default from the Dockerfile workspace-runner stage.
PANDA_DISPOSABLE_WORKSPACE_IMAGE=
# docker-stack.sh up --build only. Force rebuilding the selected workspace image
# even when the content-addressed default already exists locally.
PANDA_REFRESH_WORKSPACE=
PANDA_BUILD_WORKSPACE=
# Private network shared only by Core, environment manager, and disposable control runners.
PANDA_DISPOSABLE_RUNNER_CONTROL_NETWORK=
# Stable browser container name used for per-environment preview network attachment.
PANDA_BROWSER_RUNNER_CONTAINER_NAME=panda-browser-runner
PANDA_DISPOSABLE_RUNNER_PORT=8080
PANDA_DISPOSABLE_RUNNER_CWD=/workspace
# Host path where disposable environment files are stored and mounted from.
PANDA_ENVIRONMENTS_HOST_ROOT=
# Manager-only host/container roots for derived disposable control-runner tokens.
# Never place these below PANDA_ENVIRONMENTS_HOST_ROOT or another runner mount.
# Host default: ~/.panda-runner-secrets/disposable (separate from persistent tokens).
PANDA_DISPOSABLE_RUNNER_SECRETS_HOST_ROOT=
PANDA_DISPOSABLE_RUNNER_SECRETS_ROOT=/run/panda-runner-secrets
# Container paths used by panda-core/manager and persistent per-agent runners.
PANDA_ENVIRONMENTS_ROOT=/root/.panda/environments
PANDA_CORE_ENVIRONMENTS_ROOT=/root/.panda/environments
PANDA_RUNNER_ENVIRONMENTS_ROOT=/environments
PANDA_DISPOSABLE_CONTAINER_PREFIX=panda-env
PANDA_DISPOSABLE_CREATE_TIMEOUT_MS=300000

# Browser execution
# panda-core only. URL for the isolated browser-runner service.
BROWSER_RUNNER_URL=
# Shared bearer token used between panda-core and browser-runner.
BROWSER_RUNNER_SHARED_SECRET=
# browser-runner only.
BROWSER_RUNNER_PORT=8080
BROWSER_RUNNER_HOST=0.0.0.0
# browser-runner only. Durable session state and scratch artifact root.
BROWSER_RUNNER_DATA_DIR=
# browser-runner only. Exact private hostnames allowed for Panda-owned internal services.
BROWSER_ALLOW_PRIVATE_HOSTS=
# Optional browser-runner tuning.
BROWSER_ACTION_TIMEOUT_MS=
BROWSER_SESSION_IDLE_TTL_MS=
BROWSER_SESSION_MAX_AGE_MS=

# Public web resource fetch safety bound. Defaults to 10000000; maximum 104857600 bytes.
WEB_FETCH_DOWNLOAD_LIMIT_BYTES=

# Default chat config
# Use a canonical selector like `openai-codex/gpt-5.4` or a small alias like `gpt` / `opus`.
DEFAULT_MODEL=anthropic-oauth/claude-sonnet-4-5

# Optional live smoke / opt-in E2E overrides
# Disposable database used by `panda smoke` and `pnpm test:live`.
TEST_DATABASE_URL=postgresql:///panda_test
# Optional live-test model override. Falls back to the agent's normal default when empty.
TEST_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_OAUTH_TOKEN=
OPENAI_MODEL=gpt-5.1
OPENAI_CODEX_MODEL=gpt-5.4

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_OAUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-4-5
PI_CACHE_RETENTION=long

# Kimi Code membership
KIMI_API_KEY=

# Optional tools / connectors
BRAVE_API_KEY=
# Optional import helper for `panda telegram account import-env`; runtime workers use stored accounts.
TELEGRAM_BOT_TOKEN=
# Docker stack helper. Set true after one or more Telegram connector accounts are stored and enabled.
TELEGRAM_ENABLED=
# Whole Telegram daemon ceiling; all bot accounts share this pool.
PANDA_TELEGRAM_DB_POOL_MAX=2
# Docker stack helper. Set true after one or more Discord connector accounts are stored and enabled.
DISCORD_ENABLED=
# Whole Discord daemon ceiling; all bot accounts and voice notifications share this pool.
PANDA_DISCORD_DB_POOL_MAX=2
# Experimental private GPT-Live call provider. Disabled by default.
PANDA_LIVE_VOICE_ENABLED=false
# Optional provider acknowledgement while Panda handles a delegated request.
PANDA_OPENAI_LIVE_DELEGATION_ACK_FILLER=
# Disabled by default. Enable only when infrastructure requires WebSocket ping frames.
PANDA_OPENAI_LIVE_SIDEBAND_PING_MS=0
# Docker stack helper. Set true to run the all-enabled WhatsApp account supervisor.
WHATSAPP_ENABLED=
# Whole WhatsApp daemon ceiling; all linked accounts share this pool.
PANDA_WHATSAPP_DB_POOL_MAX=2
# Maximum decrypted media bytes accepted from one WhatsApp message.
PANDA_WHATSAPP_MAX_MEDIA_BYTES=26214400
# End-to-end deadline for one WhatsApp media download.
PANDA_WHATSAPP_MEDIA_DOWNLOAD_TIMEOUT_MS=30000
# Whole-supervisor media budget shared by every linked WhatsApp account.
PANDA_WHATSAPP_MEDIA_CONCURRENCY=2
PANDA_WHATSAPP_MEDIA_QUEUE_MAX=16
# WhatsApp worker healthcheck port inside the container.
PANDA_WHATSAPP_HEALTH_PORT=8093
# Signed Meta Cloud Calling webhook. Publish through a TLS reverse proxy.
PANDA_WHATSAPP_CALL_WEBHOOK_HOST=127.0.0.1
PANDA_WHATSAPP_CALL_WEBHOOK_PORT=8096
PANDA_WHATSAPP_CALL_WEBHOOK_PUBLISH_HOST=127.0.0.1
PANDA_WHATSAPP_CALL_WEBHOOK_PUBLISH_PORT=8096
# Optional WhatsApp Web version pin. Leave empty to fetch the current Web version.
PANDA_WHATSAPP_VERSION=

# Optional Panda Trace host-level log collector discovery. Disabled by default.
# This only adds docker labels for an operator-owned panda_trace_collector running on the host;
# it does not start a collector container and must not include PANDA_TRACE_KEY in this .env.
PANDA_TRACE_COLLECTOR_ENABLED=
# Comma-separated selected services: core,browser,telegram,discord,whatsapp,gateway.
PANDA_TRACE_COLLECTOR_SERVICES=
# Label value sent as panda_trace.environment. Defaults to prod when empty.
PANDA_TRACE_ENVIRONMENT=prod
# Required per selected service. Values are Panda Trace source ids such as src_...
PANDA_TRACE_SOURCE_CORE=
PANDA_TRACE_SOURCE_BROWSER=
PANDA_TRACE_SOURCE_TELEGRAM=
PANDA_TRACE_SOURCE_DISCORD=
PANDA_TRACE_SOURCE_WHATSAPP=
PANDA_TRACE_SOURCE_GATEWAY=

# Optional local data dir override
DATA_DIR=

# Panda Gateway attachment limits and retention
GATEWAY_MAX_ATTACHMENT_BYTES=10485760
GATEWAY_MAX_ATTACHMENTS_PER_EVENT=5
GATEWAY_MAX_EVENT_ATTACHMENT_BYTES=26214400
GATEWAY_ATTACHMENT_BYTES_PER_HOUR=104857600
GATEWAY_MAX_PENDING_ATTACHMENTS_PER_SOURCE=100
# Durable validation slots include identical retries; no DB connection is held during body IO.
GATEWAY_MAX_CONCURRENT_ATTACHMENT_UPLOADS=8
GATEWAY_ATTACHMENT_REQUEST_TIMEOUT_MS=60000
GATEWAY_ATTACHMENT_UPLOAD_TTL_MS=3600000
GATEWAY_ATTACHMENT_RETENTION_MS=604800000
GATEWAY_ATTACHMENT_QUARANTINE_TTL_MS=86400000
GATEWAY_ATTACHMENT_ALLOWED_MIME_TYPES=text/plain,application/json,application/pdf,image/png,image/jpeg,image/webp,image/gif,audio/mpeg,audio/mp4,audio/m4a,audio/ogg,audio/opus

# A2A config
A2A_MAX_MESSAGES_PER_HOUR=300

# Local Wiki.js
WIKI_URL=http://wiki:3000
WIKI_ADMIN_EMAIL=
WIKI_ADMIN_PASSWORD=
WIKI_IMAGE=ghcr.io/requarks/wiki:2
WIKI_PUBLISH_PORT=
WIKI_SITE_URL=
WIKI_SEARCH_DICT_LANGUAGE=simple
WIKI_DB_URL=
# Optional host cert file mounted into Wiki.js as /etc/ssl/certs/panda-postgres-ca.crt.
WIKI_DB_SSL_CERT_FILE=
WIKI_DB_SSL_CA=
